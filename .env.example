# FitCouple - Environment Variables Template
# Copy this file to .env for local development. Never commit real credentials to Git.

# Application Port (Non-conflicting with existing services on host)
PORT=3005

# PostgreSQL Database Configuration (Local Docker container)
POSTGRES_USER=fitcouple_user
POSTGRES_PASSWORD=fitcouple_dev_secret
POSTGRES_DB=fitcouple_db
POSTGRES_PORT=5438

# Prisma Database Connection URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# Next.js / NextAuth Session Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=generate_a_random_32_character_string_here
NEXTAUTH_URL=http://localhost:3005
